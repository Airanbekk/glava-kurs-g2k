# Настройки модели. Скопируйте в .env при необходимости; без .env конвейер сам выберет режим по подписке.
# Файл .env не попадает в git.

# --- Режим 1 (по умолчанию, бесплатно): Claude Code по вашей подписке ---
# Один раз выполните вход: claude auth login
# LLM_BACKEND=claude-code
# LLM_MODEL=claude-sonnet-5-5          # генерация слоя и заданий (экономно)
# LLM_MODEL_REVIEW=claude-sonnet-5-5   # модуль проверки; на контроле Sonnet 80%, Opus 95%, ложных тревог 0 у обоих
# LLM_WORKERS=3                        # параллельных запросов
# CLAUDE_BIN=C:\путь\к\claude.exe      # если не найден автоматически

# --- Режим 2: Anthropic API по ключу (платно) ---
# LLM_BACKEND=api
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_FALLBACKS=1

# --- Режим 3: своя локальная модель (vLLM / Ollama / LM Studio), например у компании ---
# LLM_BACKEND=openai
# LLM_BASE_URL=http://localhost:8000/v1      # vLLM; для Ollama: http://localhost:11434/v1
# LLM_MODEL=deepseek-v4-flash
# LLM_API_KEY=none
